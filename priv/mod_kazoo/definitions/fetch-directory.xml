<definition name="fetch-directory">
	<field name="fetch-info" type="reference" />
	<field name="Timestamp" type="expand" value="${expr(ceil((${Event-Date-Timestamp} / 1000000) + ${UNIX_EPOCH_IN_GREGORIAN}))}" serialize-as="number" />
	<field name="Action"/>
	<field name="user"/>
	<field name="group"/>
	<field name="Call-ID" type="first-of" value="Call-ID|Fetch-Call-UUID|Unique-ID" />
</definition>
